{
  "name": "nuno",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26 <27",
      "onFail": "error"
    }
  },
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint --max-warnings 0 .",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs --cache node_modules/.cache/dependency-cruiser --cache-strategy content --output-type err-long",
    "check:packages": "node scripts/check-packages.mjs",
    "test": "vitest run",
    "check:rules": "node scripts/check-rules-index.mjs",
    "verify:fast": "pnpm typecheck && pnpm lint && pnpm depcruise && pnpm check:packages && pnpm test && pnpm check:rules",
    "verify": "pnpm verify:fast",
    "new:context": "node scripts/new-context.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "catalog:",
    "typescript-eslint": "~8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
