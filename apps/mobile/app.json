{
  "expo": {
    "name": "NUNO",
    "slug": "nuno",
    "scheme": "nuno",
    "version": "0.0.0",
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "옷 사진을 골라 옷장에 넣을 때 사진 보관함을 열어요.",
          "cameraPermission": "옷 사진을 찍어 옷장에 넣을 때 카메라를 써요.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
